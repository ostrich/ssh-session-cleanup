# Maintainer: ostrich <570911+ostrich@users.noreply.github.com>
pkgname=ssh-session-cleanup
pkgver=1.0.0
pkgrel=1
pkgdesc='Disconnect OpenSSH sessions before networking stops at shutdown'
url='https://github.com/ostrich/ssh-session-cleanup'
arch=('any')
license=('GPL-3.0-or-later')
depends=('openssh' 'python' 'systemd')
_commit=4b6e0f7b5f46d97328a04cc81a0ccdad73881096
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('adeb36f3d0b8993363756f2867d0f6ab5882ad38d866bf49edae4104cc9d059f')

check() {
    cd "$srcdir/$pkgname-$_commit"
    python -m unittest discover -s tests -v
}

package() {
    cd "$srcdir/$pkgname-$_commit"
    install -Dm755 "ssh-session-cleanup" "$pkgdir/usr/lib/$pkgname/ssh-session-cleanup"
    install -Dm644 "ssh-session-cleanup.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
