# Maintainer: ostrich <570911+ostrich@users.noreply.github.com>
pkgname=ssh-session-cleanup-git
_pkgname=ssh-session-cleanup
pkgver=r2.7b66f2f
pkgrel=1
pkgdesc='Disconnect OpenSSH sessions before networking stops at shutdown'
url='https://github.com/ostrich/ssh-session-cleanup'
arch=('any')
license=('GPL-3.0-or-later')
depends=('openssh' 'python' 'systemd')
makedepends=('git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

check() {
    cd "$srcdir/$_pkgname"
    python -m unittest discover -s tests -v
}

package() {
    cd "$srcdir/$_pkgname"
    make install DESTDIR="$pkgdir" PREFIX=/usr \
        UNITDIR=/usr/lib/systemd/system \
        LICENSEDIR="/usr/share/licenses/$pkgname"
}
